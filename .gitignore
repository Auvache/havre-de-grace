# Nuxt dev/build outputs
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea
.iml

# Local env files
.env
.env.*
!.env.example

# Raw audio masters (too large for git; keep compressed .mp3 derivatives only)
*.wav
# ...except the demo shelf, which is the one place a .wav is meant to be
# committed and served. See docs/demos.md for what each format costs to load —
# every file added here is in the repo's history for good.
!/public/demos/*.wav
# ...but never the commercial reference track used for A/B comparison (local only)
/public/demos/reference-track.wav
# ...nor the mastering experiments (~1.3 GB — they broke the Amplify deploy)
/public/demos/*-claude-master-*.wav

# Nuxt build output — generated by Amplify on push, never committed
.output

# Stray output if the nitro aws-amplify preset ever runs
.amplify-hosting

# Press kit zip — generated from shared/data/press.ts by modules/press-kit.ts
public/press/havre-de-grace-press-kit.zip

# The contact sheet tools/video-styles/frames.mjs writes. Scratch, always.
.frames.html
.portraits.html

# Rendered music videos — tools/video-styles/mp4.mjs
/exports
